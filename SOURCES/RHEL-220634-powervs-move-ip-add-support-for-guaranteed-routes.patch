@@ -962,6 +1011,83 @@ class PowerCloudRoute:
         if self.is_enabled():
             self._set_route_enabled(False)
 
+    def _refresh_route_info(self):
+        """Re-fetch route info from the API and update self.route_info."""
+        resource = f"/v1/routes/{self.route_id}"
+        self.route_info = self._api.send_api_request("GET", resource)
+
+    def wait_until_deployed(self, deadline):
+        """Poll until the local route reaches the 'deployed' state.
+
+        Args:
+            deadline (float): Absolute monotonic time (seconds) by which the
+                route must be deployed.  The loop stops
+                RESOURCE_AGENT_TIMEOUT_BUFFER seconds before this value so
+                that the caller has time to perform any cleanup before the
+                Pacemaker operation timeout fires.
+
+        Raises:
+            PowerCloudRouteError: If the deadline is reached before the route
+                is deployed.
+        """
+        soft_deadline = deadline - RESOURCE_AGENT_TIMEOUT_BUFFER
+        poll_interval = ROUTE_POLL_INTERVAL * (2 if self._atomic else 1)
+
+        while time.monotonic() < soft_deadline:
+            try:
+                self._refresh_route_info()
+            except (Exception, SystemExit):
+                # A transient API failure should not abort the wait — log and
+                # retry until the deadline is reached.
+                ocf.logger.warning(
+                    f"[PowerCloudRoute] wait_until_deployed: refresh failed; will retry"
+                )
+                time.sleep(poll_interval)
+                continue
+
+            if self.route_info["state"] == "deployed":
+                ocf.logger.debug(
+                    f"[PowerCloudRoute] wait_until_deployed: "
+                    f"local route '{self.route_name}' reached state 'deployed'"
+                )
+                return
+
+            ocf.logger.debug(
+                f"[PowerCloudRoute] wait_until_deployed: "
+                f"waiting for local route '{self.route_name}' "
+                f"(current state: '{self.route_info['state']}')"
+            )
+            time.sleep(poll_interval)
+
+        raise PowerCloudRouteError(
+            f"wait_until_deployed: timed out waiting for local route "
+            f"'{self.route_name}' to reach state 'deployed' "
+            f"(current state: '{self.route_info['state']}')",
+            ocf.OCF_ERR_GENERIC,
+        )
+
+    def switch_enabled(self):
+        """Atomically enable this (local) route and disable the remote route.
+
+        Issues a POST to /v1/routes/{route_id}/switch-enabled with the remote
+        route's full CRN as disabledRouteCRN.  This requires that
+        self._remote_route_crn was populated during _parse_route_map, which is
+        always the case for a local (non-remote) route instance.
+        """
+        if not self._remote_route_crn:
+            raise PowerCloudRouteError(
+                "switch_enabled: remote route CRN is not available",
+                ocf.OCF_ERR_GENERIC,
+            )
+        resource = f"/v1/routes/{self.route_id}/switch-enabled"
+        data = json.dumps({"disabledRouteCRN": self._remote_route_crn})
+        ocf.logger.debug(
+            f"[PowerCloudRoute] switch_enabled: atomically enabling route '{self.route_name}' "
+            f"and disabling remote route CRN '{self._remote_route_crn}'"
+        )
+        response = self._api.send_api_request("POST", resource, data=data)
+        ocf.logger.debug(f"[PowerCloudRoute] switch_enabled: response: '{response}'")
+
 
